{
  "hosting": [
    {
      "target": "api",
      "public": "firebase/api",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "aursuq-api",
            "region": "europe-west3"
          }
        }
      ]
    }
  ]
}
